# Base OCP release image used as --from-release for the custom payload.
# Read by ocp-create-payload when -b/--base-release is not passed.
OCP_VERSION=registry.ci.openshift.org/ocp/release-5:5.1.0-0.nightly-YYYY-MM-DD-HHMMSS

# Registry namespace for built images (REQUIRED - set to your quay.io namespace)
QUAY_NAMESPACE="quay.io/<your-namespace>"

# Image tag for built images (default: latest)
IMAGE_TAG=latest

# Target image for custom payload
TARGET_IMAGE="quay.io/<your-namespace>/custom-ocp-payload:5.0-test"

# Location for your pull secret
export REGISTRY_AUTH_FILE=~/.config/containers/auth.json
